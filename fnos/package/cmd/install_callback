#!/bin/bash
set -u

ARIA2_BIN="${TRIM_APPDEST}/bin/aria2/aria2c"

mkdir -p "${TRIM_PKGVAR}/logs" "${TRIM_PKGVAR}/aria2" "${TRIM_PKGETC}" 2>/dev/null || true

if [ ! -f "$ARIA2_BIN" ]; then
    echo "内置 aria2 二进制缺失：$ARIA2_BIN" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
fi

chmod 755 "$ARIA2_BIN" 2>/dev/null || true

if [ -n "${TRIM_DATA_ACCESSIBLE_PATHS+x}" ]; then
    printf '%s' "$TRIM_DATA_ACCESSIBLE_PATHS" > "${TRIM_PKGVAR}/auth_paths" 2>/dev/null || true
    chmod 644 "${TRIM_PKGVAR}/auth_paths" 2>/dev/null || true
fi

exit 0
